// FlowForge database schema.
// Primary target: PostgreSQL (Prisma ORM). The identical schema also runs on SQLite
// for zero-dependency local development (provider is injected via env in migrations).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = env("DATABASE_PROVIDER")
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  name               String
  passwordHash       String
  emailVerifiedAt    DateTime?
  verificationToken  String?  @unique
  resetToken         String?  @unique
  resetTokenExpires  DateTime?
  image              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships        Membership[]
  apiKeys            ApiKey[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  comments           Comment[]
  sessions           Session[]
  sentInvitations    Invitation[] @relation("InvitedBy")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces Workspace[]
  members    Membership[]
  subscription Subscription?
  usageRecords UsageRecord[]
}

model Workspace {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  slug           String   @unique
  settings       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships   Membership[]
  automations   Automation[]
  integrations  IntegrationConnection[]
  webhooks      Webhook[]
  executions    Execution[]
  auditLogs     AuditLog[]
  notifications Notification[]
  apiKeys       ApiKey[]
  invitations   Invitation[]

  @@index([organizationId])
}

enum Role {
  owner
  admin
  builder
  operator
  viewer
}

model Membership {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  organizationId String
  role        Role     @default(viewer)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Invitation {
  id          String   @id @default(uuid())
  email       String
  workspaceId String
  invitedById String
  role        Role     @default(viewer)
  token       String   @unique
  status      String   @default("pending") // pending | accepted | expired | revoked
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([email, workspaceId])
}

model Automation {
  id                String   @id @default(uuid())
  workspaceId       String
  name              String
  description       String   @default("")
  status            String   @default("draft") // draft | active | disabled | archived
  publishedVersionId String?  @unique
  currentVersionId  String   @unique
  lastRunAt         DateTime?
  lastModifiedById  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions  AutomationVersion[] @relation("Versions")
  published AutomationVersion?  @relation("Published", fields: [publishedVersionId], references: [id])
  currentVersion AutomationVersion @relation("Current", fields: [currentVersionId], references: [id])
  nodes       WorkflowNode[]
  connections WorkflowConnection[]
  triggers    WorkflowTrigger[]
  schedules   WorkflowSchedule[]
  webhooks    Webhook[]
  executions  Execution[]
  comments    Comment[]
  auditLogs   AuditLog[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
}

model AutomationVersion {
  id           String   @id @default(uuid())
  automationId String
  version      Int
  definition   Json     // { nodes: [], connections: [] }
  changeSummary String  @default("")
  createdById  String?
  createdAt    DateTime @default(now())

  automation Automation @relation("Versions", fields: [automationId], references: [id], onDelete: Cascade)
  publishedOf Automation? @relation("Published")
  currentOf  Automation?  @relation("Current")

  @@unique([automationId, version])
}

model WorkflowNode {
  id            String  @id @default(uuid())
  automationId  String
  externalId    String  // id within the definition
  type          String
  name          String
  positionX     Float   @default(0)
  positionY     Float   @default(0)
  configuration Json    @default("{}")
  inputSchema   Json?
  outputSchema  Json?
  metadata      Json?
  updatedAt     DateTime @updatedAt

  automation  Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  outgoing    WorkflowConnection[] @relation("Source")
  incoming    WorkflowConnection[] @relation("Target")

  @@unique([automationId, externalId])
}

model WorkflowConnection {
  id           String @id @default(uuid())
  automationId String
  externalId   String
  sourceNodeId String
  sourceHandle String @default("out")
  targetNodeId String
  targetHandle String @default("in")

  automation Automation   @relation(fields: [automationId], references: [id], onDelete: Cascade)
  source     WorkflowNode @relation("Source", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  target     WorkflowNode @relation("Target", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([automationId, externalId])
}

model WorkflowTrigger {
  id           String @id @default(uuid())
  automationId String
  nodeExternalId String
  type         String // manual | schedule | webhook | form | database
  config       Json   @default("{}")
  enabled      Boolean @default(true)

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, nodeExternalId])
}

model WorkflowSchedule {
  id           String  @id @default(uuid())
  automationId String
  cron         String
  timezone     String  @default("UTC")
  enabled      Boolean @default(true)
  nextRunAt    DateTime?
  lastRunAt    DateTime?

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
}

model IntegrationConnection {
  id           String  @id @default(uuid())
  workspaceId  String
  key          String   // rest-api | webhook | email | postgresql | slack | discord
  name         String
  config       Json     @default("{}")
  status       String   @default("connected") // connected | disconnected | error
  connectedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credentials Credential[]

  @@unique([workspaceId, key])
}

model Credential {
  id            String @id @default(uuid())
  connectionId  String
  name          String
  encryptedValue String // AES-256-GCM ciphertext (never plaintext)
  maskedValue   String  // display-only mask e.g. "sk-••••3f9a"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, name])
}

model Webhook {
  id           String  @id @default(uuid())
  workspaceId  String
  automationId String?
  path         String  @unique  // random public segment
  name         String
  method       String  @default("POST")
  secret       String          // HMAC signing secret (server-side only)
  active       Boolean @default(true)
  lastReceivedAt DateTime?
  requestCount Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation  Automation?  @relation(fields: [automationId], references: [id], onDelete: SetNull)
  deliveries  WebhookDelivery[]

  @@index([automationId])
}

model WebhookDelivery {
  id         String  @id @default(uuid())
  webhookId  String
  method     String
  headers    Json    @default("{}")
  body       Json?
  status     String  // received | executed | rejected | failed
  statusCode Int?
  error      String?
  createdAt  DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
}

model Execution {
  id            String  @id @default(uuid())
  workspaceId   String
  automationId  String
  versionId     String?
  status        String  // queued|running|waiting|completed|failed|cancelled
  triggerSource String  // manual|webhook|schedule|test|api
  input         Json?
  error         String?
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  nodeCount     Int     @default(0)
  retriedFromId String?

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation   @relation(fields: [automationId], references: [id], onDelete: Cascade)
  nodes      ExecutionNode[]
  logs       ExecutionLog[]
  retriedFrom Execution?   @relation("Retries", fields: [retriedFromId], references: [id])
  retries    Execution[]    @relation("Retries")

  @@index([workspaceId, startedAt])
  @@index([automationId, startedAt])
  @@index([status])
}

model ExecutionNode {
  id          String  @id @default(uuid())
  executionId String
  nodeId      String
  nodeType    String
  name        String
  status      String
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  durationMs  Int     @default(0)
  attempts    Int     @default(1)

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

model ExecutionLog {
  id          String  @id @default(uuid())
  executionId String
  level       String
  message     String
  data        Json?
  createdAt   DateTime @default(now())

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

model ApiKey {
  id          String   @id @default(uuid())
  workspaceId String?
  userId      String
  name        String
  prefix      String   // first chars for display
  hashedKey   String   @unique // sha256 — raw key never stored
  scopes      String   @default("read")
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String?
  action      String   // e.g. automation.published
  entityType  String
  entityId    String?
  summary     String   // human-readable line
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  automation Automation?  @relation(fields: [entityId], references: [id])

  @@index([workspaceId, createdAt])
}

model Comment {
  id           String   @id @default(uuid())
  automationId String
  authorId     String
  body         String
  createdAt    DateTime @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([automationId, createdAt])
}

model Notification {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String?
  type        String   // execution.failed | deployment.success | team.invitation | subscription.event | usage.warning
  title       String
  body        String
  readAt      DateTime?
  link        String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([workspaceId, createdAt])
}

model Subscription {
  id                String   @id @default(uuid())
  organizationId    String   @unique
  provider          String   @default("mock") // mock | stripe
  externalId        String?
  plan              String   @default("free")
  status            String   @default("active") // active | trialing | past_due | cancelled
  billingCycle      String   @default("monthly")
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id             String   @id @default(uuid())
  organizationId String
  period         String   // YYYY-MM
  executions     Int      @default(0)
  nodeRuns       Int      @default(0)
  apiCalls       Int      @default(0)
  storageBytes   BigInt   @default(0)
  activeAutomations Int   @default(0)
  teamMembers    Int      @default(0)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, period])
}
